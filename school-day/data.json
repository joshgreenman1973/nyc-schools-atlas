  "key_voices": {
    "matthew_kraft": {
      "title": "Professor of education and economics, Brown University",
      "co_author_of": "Time for School (Education Next, 2025)",
      "key_quote": "State minimums set a floor we should be moving beyond. They are not what we should be targeting or aspiring to.",
      "secondary_quote": "Overall the evidence strongly points to additional instructional time increasing student success in school. Of course, how much time you add, when you add it, and how it's used also matter tremendously. But it is one of those necessary but not sufficient inputs into supporting a successful education."
    },
    "david_bloomfield": {
      "title": "Professor of education, law, and public policy, Brooklyn College and CUNY Graduate Center",
      "key_quote": "What seems like 180 days isn't really. A child's individual calendar may differ from grade to grade, program to program because of testing and other non-instructional obligations.",
      "fragmentation_observation": "Out of 45 school weeks, less than half — about 20 — have complete five-day weeks."
    },
    "kamar_samuels": {
      "title": "NYC Schools Chancellor",
      "context": "Pledged to focus on chronic absenteeism",
      "quote": "Folks need to understand that if we're not in school your child is going to miss work."
    }
